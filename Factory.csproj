<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Cmdemo1.Factory</AssemblyName>
    <RootNamespace>Cmdemo1.Factory</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole AI Software Factory. 0.x packages: pin the version when a release must not move. -->
    <PackageReference Include="Aisf.Hosting" Version="0.1.0-alpha.*" />
    <!-- The messaging framework the factory runs on. Aisf.Hosting names none (from 0.1.0-alpha.5);
         without a provider the host stops at startup with "No messaging provider is deployed with this host". -->
    <PackageReference Include="Aisf.Messaging.NServiceBus" Version="0.1.0-alpha.*" />
    <!-- Where the factory follows a merged change: releases and deployments of the system's Octopus project. -->
    <PackageReference Include="Aisf.Delivery.Octopus" Version="0.1.0-alpha.*" />
  </ItemGroup>

</Project>
