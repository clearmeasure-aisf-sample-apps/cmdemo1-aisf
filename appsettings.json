{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GitHub": {
    "Owner": "clearmeasure-aisf-sample-apps",
    "OwnerType": "organization",
    "Repository": "cmdemo1-workorders",
    "ProjectNumber": 679,
    "DefaultBranch": "master"
  },
  "CiGates": {
    "RepositoryGates": {
      "clearmeasure-aisf-sample-apps/cmdemo1-workorders": [
        { "Name": "Build result", "Gating": true },
        { "Name": "secret-scan", "Gating": true }
      ]
    }
  },
  "AIWorkers": {
    "DefaultBranch": "master",
    "//AiToolColumns": "The board's Status options the factory works, in order. Each needs a prompt Prompts/cursor/cursor-<column>.md (column name lowercased, letters only); the packages supply these. A person moves an item into Technical Design to hand it to the factory. More columns (Conceptual Definition, UX Design, Test Design) can be added here and on the board without a code change.",
    "AiToolColumns": [
      "Technical Design",
      "Development",
      "Functional Testing"
    ],
    "AiToolColumnRouting": {
      "Technical Design": "Cursor",
      "Development": "Cursor",
      "Functional Testing": "Cursor"
    },
    "FunctionalValidationColumn": "Functional Testing",
    "DevelopmentColumn": "Development",
    "RequiredBodySectionByColumn": {
      "Technical Design": "## Technical Design"
    },
    "ReviewVerdictColumns": [
      "Technical Design",
      "Development"
    ],
    "ReconciliationSweeperEnabled": true,
    "ReconciliationIntervalSeconds": 180,
    "CompletionOwnsAiColumnExits": true,
    "//DisableFactoryAutoMerge": "Merging is on for this factory: on a PASS verdict it approves and squash-merges the pull request of an item that carries the 'Auto Merge' label. An item without the label waits for a person to merge. Remove this line to turn merging off again (the packages' default).",
    "DisableFactoryAutoMerge": false
  },
  "CursorAgent": {
    "RepositoryUrl": "https://github.com/clearmeasure-aisf-sample-apps/cmdemo1-workorders",
    "BaseBranch": "master",
    "Model": "auto-smart",
    "ModelParams": [
      { "Id": "optimize_for", "Value": "cost" }
    ],
    "ColumnSessionMode": {
      "Development": "Team",
      "Functional Testing": "Team"
    }
  },
  "ToolsApi": {
    "FunctionalValidationColumn": "Functional Testing",
    "DevelopmentColumn": "Development"
  }
}
