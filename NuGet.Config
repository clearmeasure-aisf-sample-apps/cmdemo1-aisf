<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The AI Software Factory packages. Private: restoring needs a token with read:packages,
         supplied as NuGetPackageSourceCredentials_aisf (see the Dockerfile). -->
    <add key="aisf" value="https://nuget.pkg.github.com/ClearMeasureLabs/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="aisf">
      <package pattern="Aisf.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
